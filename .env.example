# Copy this file to .env and fill it in. The real .env is ignored by git.
# Never put real passwords or keys in YAML files or in code.

# Base URL of caudal-backend (no trailing slash).
CAUDAL_SIM_API_BASE_URL=http://localhost:8080

# PROJECT_TEAM user that imports the simulated history. Only that role can import.
CAUDAL_SIM_API_USERNAME=project.team
CAUDAL_SIM_API_PASSWORD=change-me-with-a-long-password

# Public slug of the demo aqueduct. The import is aborted if it is not a demo aqueduct.
CAUDAL_SIM_DEMO_AQUEDUCT_SLUG=guaitarilla-demo

# Identifiers of the demo aqueduct and its tank, as created in the backend.
CAUDAL_SIM_AQUEDUCT_ID=00000000-0000-7000-8000-000000000000
CAUDAL_SIM_TANK_ID=00000000-0000-7000-8000-000000000001

# Ed25519 private key (PEM) used to sign import manifests. Lives in keys/, never in git.
# Create it with: openssl genpkey -algorithm ed25519 -out keys/ed25519-private.pem
CAUDAL_SIM_PRIVATE_KEY_PATH=keys/ed25519-private.pem

# Timeout of each HTTP call to the API, in seconds.
CAUDAL_SIM_HTTP_TIMEOUT_SECONDS=10
