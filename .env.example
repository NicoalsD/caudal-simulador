# Copy this file to .env and fill it in. The real .env is ignored by git.
# Never put real passwords or keys in YAML files or in code.

# Base URL of caudal-backend (no trailing slash).
CAUDAL_SIM_API_BASE_URL=http://localhost:8080

# PROJECT_TEAM user that imports the simulated history. Only that role can import.
CAUDAL_SIM_API_USERNAME=project.team
CAUDAL_SIM_API_PASSWORD=change-me-with-a-long-password

# Public slug of the demo aqueduct. The import is aborted if it is not a demo aqueduct.
CAUDAL_SIM_DEMO_AQUEDUCT_SLUG=guaitarilla-demo

# Identifiers of the demo aqueduct and its tank, as created in the backend.
CAUDAL_SIM_AQUEDUCT_ID=00000000-0000-7000-8000-000000000000
CAUDAL_SIM_TANK_ID=00000000-0000-7000-8000-000000000001

# Ed25519 private key (PEM) used to sign import manifests. Lives in keys/, never in git.
# Create it with: openssl genpkey -algorithm ed25519 -out keys/ed25519-private.pem
CAUDAL_SIM_PRIVATE_KEY_PATH=keys/ed25519-private.pem

# Timeout of each HTTP call to the API, in seconds.
CAUDAL_SIM_HTTP_TIMEOUT_SECONDS=10

# Local dashboard API (caudal-sim tablero). The default host is loopback: only this computer.
# Change it only inside a container or on a network you trust.
CAUDAL_SIM_DASHBOARD_HOST=127.0.0.1
CAUDAL_SIM_DASHBOARD_PORT=8000

# Live mode (caudal-sim live). Each identity is a real account of the demo aqueduct.
# The operator sends the readings; the board is only needed for --auto-junta.
CAUDAL_SIM_LIVE_OPERATOR_USERNAME=operator.sim
CAUDAL_SIM_LIVE_OPERATOR_PASSWORD=change-me-with-a-long-password
CAUDAL_SIM_LIVE_BOARD_USERNAME=board.sim
CAUDAL_SIM_LIVE_BOARD_PASSWORD=change-me-with-a-long-password
# Identifier of the simulated node, registered in the backend (devices.devices).
CAUDAL_SIM_LIVE_DEVICE_ID=00000000-0000-7000-8000-000000000002
# Real seconds per simulated hour at speed 1 (the dashboard can speed it up).
CAUDAL_SIM_LIVE_HOUR_SECONDS=1.0

# Virtual maqueta (caudal-sim maqueta). Three signed devices registered in the backend: the level
# sensor of the tank and one valve actuator per outlet. Each has its own key pair, and each
# private key lives in keys/ (git-ignored) or at the path given here. Never commit them.
CAUDAL_SIM_MAQUETA_API_BASE_URL=http://localhost:8080
CAUDAL_SIM_MAQUETA_HTTP_TIMEOUT_SECONDS=10
CAUDAL_SIM_MAQUETA_SENSOR_DEVICE_ID=00000000-0000-7000-8000-0000000000a1
CAUDAL_SIM_MAQUETA_SENSOR_PRIVATE_KEY_PATH=keys/maqueta-sensor.pem
CAUDAL_SIM_MAQUETA_VALVE_1_DEVICE_ID=00000000-0000-7000-8000-0000000000a2
CAUDAL_SIM_MAQUETA_VALVE_1_VALVE_ID=00000000-0000-7000-8000-0000000000b1
CAUDAL_SIM_MAQUETA_VALVE_1_PRIVATE_KEY_PATH=keys/maqueta-valve-1.pem
CAUDAL_SIM_MAQUETA_VALVE_2_DEVICE_ID=00000000-0000-7000-8000-0000000000a3
CAUDAL_SIM_MAQUETA_VALVE_2_VALVE_ID=00000000-0000-7000-8000-0000000000b2
CAUDAL_SIM_MAQUETA_VALVE_2_PRIVATE_KEY_PATH=keys/maqueta-valve-2.pem
